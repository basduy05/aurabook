# ============================================================
# AuraBook — Root Environment Variables
# Copy sang .env và điền giá trị thật vào
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=aurabook_user
POSTGRES_PASSWORD=aurabook_secure_password
POSTGRES_DB=aurabook_saleor
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Saleor Backend ---
SALEOR_SECRET_KEY=django-insecure-REPLACE-WITH-SECURE-50-CHAR-KEY
BACKEND_PORT=8000
DEBUG=True
DEFAULT_FROM_EMAIL=no-reply@aurabook.vn

# --- Saleor Frontend ---
FRONTEND_PORT=3000
NODE_ENV=development

# --- Saleor Dashboard ---
DASHBOARD_PORT=9000

# --- AuraBook Custom ---
GEMINI_API_KEY=your-gemini-api-key-here
DRM_MASTER_KEY=your-32-byte-hex-drm-master-key-here
RSA_PRIVATE_KEY=

# --- JWT (Saleor dùng RSA, không cần custom) ---
# Legacy chỉ để tham khảo
# JWT_SECRET=...
