# ==============================================================================
# AuraBook Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and adjust the values to your environment:
# cp .env.example .env

# --- General Application Settings ---
APP_NAME=AuraBook
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# --- Backend FastAPI Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Authentication & Security ---
# Generate secure key using: openssl rand -hex 32
JWT_SECRET=aurabook_super_secret_jwt_key_change_in_production_32chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PostgreSQL Database Configuration ---
POSTGRES_USER=aurabook_user
POSTGRES_PASSWORD=aurabook_secure_password
POSTGRES_DB=aurabook_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Local connection string (used in Docker: postgres://... or localhost if running natively)
DATABASE_URL=postgresql+asyncpg://aurabook_user:aurabook_secure_password@postgres:5432/aurabook_db

# --- Redis Cache & Queue Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# --- AI & External Integrations ---
# Google Gemini API key for AuraBook AI services
GEMINI_API_KEY=your_gemini_api_key_here

# --- Frontend Next.js Configuration ---
NEXT_PUBLIC_APP_NAME=AuraBook
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=3000
